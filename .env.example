# Copie para .env.local (nunca commite segredos). Na Vercel, configure em Project → Settings → Environment Variables.

# --- Banco (Neon via Vercel Marketplace: injetadas automaticamente pela integração) ---
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# --- Better Auth ---
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# --- Google OAuth (console.cloud.google.com → APIs & Services → Credentials) ---
# URI de redirecionamento autorizado: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OpenRouter (openrouter.ai/keys) ---
# Recomendado: comprar US$10 de créditos uma única vez → limite de 1000 req/dia nos modelos :free (sem créditos: 50/dia).
# Ative o Guardrail "Prompt injection" (Security) na chave, em modo "flag".
OPENROUTER_API_KEY=
# Base da API (compatível com OpenAI). Só mude para usar um proxy.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_APP_URL=http://localhost:3000
OPENROUTER_APP_NAME=Deus Provera

# --- Orçamento de IA ---
AI_DAILY_BUDGET=900
AI_USER_DAILY_LIMIT=200

# Rotina diária (vercel.json › crons): segredo enviado pela Vercel como Authorization: Bearer. Gere com: openssl rand -base64 32
CRON_SECRET=
