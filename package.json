{
  "name": "deus-provera",
  "private": true,
  "version": "0.1.0",
  "description": "Deus Proverá — plataforma de estudos com simulados configuráveis, importação de questões por PDF e IA (OpenRouter).",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:api": "vite --mode api",
    "dev:full": "vercel dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx server/db/seed.ts",
    "db:studio": "drizzle-kit studio",
    "check": "npm run typecheck && npm run lint && npm test",
    "gabarito:build": "tsx scripts/build-gabarito.ts",
    "eval:import": "tsx scripts/eval-import.ts",
    "prompt:sync": "tsx scripts/sync-prompt-doc.ts",
    "ai:ping": "tsx scripts/ai-ping.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@hono/zod-validator": "^0.9.1",
    "@neondatabase/serverless": "^1.2.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@tanstack/react-query": "^5.108.1",
    "ai": "^7.0.177",
    "better-auth": "^1.7.26",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "lucide-react": "^1.76.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/node-server": "^2.1.11",
    "@napi-rs/canvas": "^1.1.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
